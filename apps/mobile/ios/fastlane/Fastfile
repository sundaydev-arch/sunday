default_platform(:ios)

platform :ios do
  desc "Build Flutter IPA and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_PRIVATE_KEY"),
      is_key_content_base64: ENV["ASC_PRIVATE_KEY_IS_BASE64"] == "true",
      duration: 1200,
      in_house: false
    )

    setup_ci if ENV["CI"]

    if ENV["MATCH_GIT_URL"]
      match(
        type: "appstore",
        readonly: is_ci,
        api_key: api_key,
        git_url: ENV["MATCH_GIT_URL"],
        app_identifier: ENV.fetch("APP_IDENTIFIER", "app.sundaydev.sundayMobile")
      )
    end

    root = File.expand_path("../..", __dir__)
    defines = ENV["MOBILE_DART_DEFINES"] || "API_BASE_URL=https://sundaydev.vercel.app"
    sh("cd #{root} && flutter build ipa --release --dart-define=#{defines}")

    ipa = Dir[File.join(root, "build/ios/ipa/*.ipa")].first
    UI.user_error!("IPA not found") unless ipa

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload to App Store and optionally submit for review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_PRIVATE_KEY"),
      is_key_content_base64: ENV["ASC_PRIVATE_KEY_IS_BASE64"] == "true",
      duration: 1200,
      in_house: false
    )

    setup_ci if ENV["CI"]

    if ENV["MATCH_GIT_URL"]
      match(
        type: "appstore",
        readonly: is_ci,
        api_key: api_key,
        git_url: ENV["MATCH_GIT_URL"],
        app_identifier: ENV.fetch("APP_IDENTIFIER", "app.sundaydev.sundayMobile")
      )
    end

    root = File.expand_path("../..", __dir__)
    defines = ENV["MOBILE_DART_DEFINES"] || "API_BASE_URL=https://sundaydev.vercel.app"
    sh("cd #{root} && flutter build ipa --release --dart-define=#{defines}")

    ipa = Dir[File.join(root, "build/ios/ipa/*.ipa")].first
    UI.user_error!("IPA not found") unless ipa

    # Set SUBMIT_FOR_REVIEW=true to auto-click "Submit for Review".
    upload_to_app_store(
      api_key: api_key,
      ipa: ipa,
      force: true,
      submit_for_review: ENV["SUBMIT_FOR_REVIEW"] == "true",
      automatic_release: ENV["AUTOMATIC_RELEASE"] == "true",
      precheck_include_in_app_purchases: false,
      skip_metadata: ENV["SKIP_METADATA"] != "false",
      skip_screenshots: true
    )
  end
end
