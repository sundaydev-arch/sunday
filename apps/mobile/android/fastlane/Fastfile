default_platform(:android)

platform :android do
  desc "Build AAB and upload to Play internal testing"
  lane :internal do
    root = File.expand_path("../..", __dir__)
    defines = ENV["MOBILE_DART_DEFINES"] || "API_BASE_URL=https://sundaydev.vercel.app"
    sh("cd #{root} && flutter build appbundle --release --dart-define=#{defines}")

    aab = File.join(root, "build/app/outputs/bundle/release/app-release.aab")
    UI.user_error!("AAB not found at #{aab}") unless File.exist?(aab)

    upload_to_play_store(
      track: "internal",
      aab: aab,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed"
    )
  end

  desc "Upload AAB to Play production (set RELEASE_STATUS=draft to hold)"
  lane :production do
    root = File.expand_path("../..", __dir__)
    defines = ENV["MOBILE_DART_DEFINES"] || "API_BASE_URL=https://sundaydev.vercel.app"
    sh("cd #{root} && flutter build appbundle --release --dart-define=#{defines}")

    aab = File.join(root, "build/app/outputs/bundle/release/app-release.aab")
    UI.user_error!("AAB not found at #{aab}") unless File.exist?(aab)

    upload_to_play_store(
      track: "production",
      aab: aab,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: ENV.fetch("RELEASE_STATUS", "completed")
    )
  end
end
