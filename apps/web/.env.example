# Supabase (from project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — https://sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Optional: source maps upload on CI / Vercel build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog — https://posthog.com → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
# Client talks to same-origin /ingest (rewritten to PostHog). Keep for docs / EU override:
NEXT_PUBLIC_POSTHOG_HOST=/ingest
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Contact email notify — https://resend.com (optional; form still saves to Supabase)
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
# EMAIL address only (not https://…). Default is fine for Resend testing.
# Production: verify your own domain in Resend, then e.g. "Sunday <hello@yourdomain.com>"
CONTACT_NOTIFY_FROM="Sunday <onboarding@resend.dev>"
