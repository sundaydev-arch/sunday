{
  "name": "sunday",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @sunday/web start",
    "lint": "oxlint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "analyze": "turbo run analyze",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "desktop:bump": "node scripts/bump-desktop-version.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "turbo": "^2.8.12"
  },
  "engines": {
    "node": ">=20"
  }
}
