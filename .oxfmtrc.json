{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {},
  "ignorePatterns": [
    "node_modules",
    ".next",
    "out",
    "build",
    "coverage",
    "pnpm-lock.yaml",
    "playwright-report",
    "test-results",
    ".turbo",
    "dist",
    "*.tsbuildinfo"
  ]
}
